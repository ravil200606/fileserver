# Provider checked in this environment: RouterAI
# LLM_BASE_URL=https://routerai.ru/api/v1
# LLM_API_KEY=replace-with-routerai-key
# LLM_MODEL=openai/gpt-6.2-sol

# Recommended free/open provider: OpenRouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=replace-with-free-openrouter-key
LLM_MODEL=qwen/qwen3-30b-a3b:free

# Alternative free provider: Groq
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=replace-with-free-groq-key
# LLM_MODEL=qwen/qwen3-32b

# Alternative trial provider with documented tool calling: Cerebras
# LLM_BASE_URL=https://api.cerebras.ai/v1
# LLM_API_KEY=replace-with-cerebras-key
# LLM_MODEL=qwen-3.8-27b

# Backward-compatible OpenAI-only setup
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=replace-with-openai-key
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=replace-with-openai-key
# OPENAI_MODEL=gpt-4o-mini

FILESERVER_BASE_URL=http://localhost:8080
